PORT=5000
HOST=127.0.0.1

DB_HOST=localhost
DB_PORT=3306
DB_USER=replace_with_local_mysql_user
DB_PASSWORD=replace_with_local_mysql_password

DB_NAME=learnspace_db

# Comma-separated exact browser origins; do not use * with credentials enabled.
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# Files are stored outside the frontend's static root. The path is private to the backend process.
FILE_STORAGE_DIR=./private-storage
FILE_STORAGE_PROVIDER=local
